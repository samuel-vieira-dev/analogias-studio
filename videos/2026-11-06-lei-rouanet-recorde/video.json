  "texto": [
    "recorde da | # [rouanet]:",
    "bilhões em imposto | que o governo | # deixa de [receber|vermelho].",
    "este ano, a lei rouanet | # recebeu mais de [25 mil]",
    "propostas, | o maior número | # da [história|preto].",
    "e captou 1 bilhão | # e [670 milhões] | até outubro,",
    "# [recorde] pro período.",
    "no ano passado, | # foram [3,4 bilhões],",
    "o terceiro | # recorde [seguido|circulo].",
    "porém, esse dinheiro | # [não|vermelho] sai do orçamento | da cultura.",
    "ele sai do | # [imposto de renda|preto].",
    "funciona assim: | o ministério da cultura | # [aprova] o projeto,",
    "ou seja, dá | # [licença] | pra buscar patrocínio.",
    "então, uma empresa | que deve imposto | # pode mandar até [4%]",
    "dele direto | # pra conta do [projeto].",
    "pessoa física, | # até [6%].",
    "em teatro, livros, | música instrumental | # e [patrimônio],",
    "o desconto | # é de [100%|preto].",
    "nesses casos, a empresa | # [escolhe] o projeto | e põe a marca,",
    "mas o dinheiro | # é [imposto|vermelho]",
    "que o governo | # deixa de [receber].",
    "é a | # [renúncia fiscal|preto].",
    "a maior patrocinadora | # é a [petrobras], | uma estatal:",
    "# [278 milhões] | este ano, até agosto.",
    "o discurso oficial | # é que [vale a pena|verde]:",
    "um estudo da | # [fgv], encomendado | pelo ministério,",
    "diz que cada real | # movimentou mais de [7 reais] | na economia.",
    "porém, críticos | # apontam a [concentração|vermelho]:",
    "no ano passado, | # [72%] do dinheiro | ficou no sudeste.",
    "e o recorde deste ano | # ainda deve [crescer]:",
    "no ano passado, | # mais da [metade|circulo] | do dinheiro",
    "só entrou | # em [novembro e dezembro|preto]."
