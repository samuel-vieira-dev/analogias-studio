 "texto": [
  "em 36 anos, | # o foro de [são paulo]",
  "juntou fidel, ortega | # e [maduro|vermelho].",
  "ele nasceu em | # [julho de 1990], | em são paulo.",
  "lula e | # [fidel castro] | chamaram 48 partidos",
  "e grupos de | # [esquerda], meses depois",
  "da queda do | # muro de [berlim].",
  "hoje, são | # mais de [100] partidos | de 27 países.",
  "entre eles, o pt, | # o partido [comunista] | de cuba,",
  "a frente sandinista, | # de daniel [ortega],",
  "e o partido | # de nicolás [maduro].",
  "segundo lula, a ideia | # era [convencer] a esquerda",
  "de que o caminho | # pro poder era o [voto|verde],",
  "e não a | # [luta armada|riscado].",
  "porém, em 2017, o encontro | # foi em [manágua],",
  "organizado pelo | # partido de [ortega].",
  "em 2019, foi | # em [caracas],",
  "e maduro discursou | # no [encerramento].",
  "e em janeiro deste ano, | # quando os [estados unidos]",
  "prenderam maduro, | o foro chamou | # a prisão de [sequestro|vermelho].",
  "na prática, | # o foro não [governa|riscado] nada:",
  "faz encontros | # e publica [notas].",
  "e é aí | # que entra a [lei].",
  "a constituição | # [proíbe] partido brasileiro",
  "de receber dinheiro de governo | # ou entidade [estrangeira],",
  "ou de ficar | # [subordinado] a eles.",
  "se receber, | # a lei dos [partidos]",
  "manda o tse | # [cancelar|vermelho] o registro.",
  "ou seja, o pt pode | # dividir a [mesa]",
  "com o partido | # de [maduro],",
  "mas não pode receber | # [dinheiro] nem ordem dele.",
  "já a ursal, | citada no debate de 2018, | # nunca [existiu|vermelho]:",
  "foi uma | # [piada] de 2001,",
  "de uma socióloga | # crítica do [pt]."
 ],
